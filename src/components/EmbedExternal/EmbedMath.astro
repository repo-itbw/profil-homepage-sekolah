---
import katex from 'katex';

interface Props {
  formula: string;
}

const { formula } = Astro.props;

// Merender string murni secara langsung di peladen (Server-Side)
const htmlOutput = katex.renderToString(formula, {
  displayMode: true,
  throwOnError: false, // Outputkan error kustom, bukan crash
  errorColor: '#eab308'
});
---

<!-- Tampilkan HTML matang (sudah berbentuk DOM KaTeX) -->
<div class="my-6 py-4 overflow-x-auto text-center text-lg sm:text-xl text-blackcoal">
  <Fragment set:html={htmlOutput} />
</div>
