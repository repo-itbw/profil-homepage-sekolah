---
const { youtubeUrl } = Astro.props;

// Fungsi RegEx pencari ID unik sepanjang 11 karakter milik YouTube
const extractVideoID = (url: string) => {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  // Validasi ketat: Pastikan ID ditemukan dan panjangnya tepat 11 karakter
  return (match && match[2].length === 11) ? match[2] : null;
};

const videoId = extractVideoID(youtubeUrl);
---

{/* Render Kondisional: Menampilkan iframe jika RegEx berhasil, memunculkan pesan galat jika URL cacat */}
{videoId ? (
  <div class="w-full aspect-video rounded-xl overflow-hidden my-8 shadow-md border border-gray-100">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${videoId}`}
      class="w-full h-full"
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="p-4 border border-dashed border-red-400 bg-red-50 text-red-600 rounded-xl my-8 text-center text-sm font-lato">
    <strong>Gagal Memuat Video:</strong> Tautan YouTube tidak valid. Harap periksa kembali URL yang dimasukkan.
  </div>
)}
