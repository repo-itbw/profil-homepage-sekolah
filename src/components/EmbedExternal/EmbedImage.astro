---
const { url, alt, caption } = Astro.props;
---
<figure class="my-8 flex flex-col items-center group">
  <!-- Elemen gambar mematuhi gaya sudut melengkung bawaan desain Anda -->
  <img
    src={url}
    alt={alt}
    loading="lazy"
    class="w-full rounded-2xl shadow-sm object-cover border border-gray-100"
  />
  
  <!-- Render kondisional: Keterangan (Caption) hanya dirender jika data diisi oleh pengguna -->
  {caption && (
    <figcaption class="mt-3 text-xs sm:text-sm text-gray-500 font-comfortaa italic text-center px-4">
      {caption}
    </figcaption>
  )}
</figure>
