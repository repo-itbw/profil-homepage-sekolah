---
import { Icon } from 'astro-icon/components';

// ============================================================================
// DATA FRONTMATTER (Pusat Kendali Konten)
// ============================================================================
const profilKepsek = {
  nama: "Dede Budiman S.pd., M.Si",
  jabatan: "Kepala SMK Bina Wisata Lembang",
  nuptk: "NUPTK. 4148773674130223",
  foto: "/assets/sambutan.jpg",
  
  kutipan: "Pendidikan vokasi bukan sekadar mencetak pekerja, melainkan mengasah inovator yang siap menantang masa depan.",
  
  paragraf1: "Selamat datang di SMK Bina Wisata Lembang. Di era disrupsi teknologi dan transformasi industri saat ini, kami berkomitmen untuk tidak hanya menjadi tempat belajar, tetapi menjadi ekosistem pembentuk karakter dan kompetensi. Tantangan global menuntut lulusan yang adaptif, tangguh, dan memiliki etos kerja profesional.",
  paragraf2: "Melalui kurikulum yang diselaraskan langsung dengan industri (Link & Match), fasilitas laboratorium modern, serta tenaga pendidik tersertifikasi, kami bertekad mengantarkan putra-putri Anda menjadi talenta unggul yang siap memimpin di dunia usaha dan dunia industri (DUDI)."
};
---

<section class="relative w-full bg-alabaster py-16 lg:py-24 border-b border-gray-200/60 overflow-hidden">
  <!-- Elemen Dekoratif Latar Belakang -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-corporate-blue/5 rounded-bl-[100px] pointer-events-none"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col">
      
      <!-- 1. Lencana Estetis (Garis Pembatas Simetris di Tengah) -->
            <div class="flex items-center justify-center gap-3 sm:gap-4 mb-8">
              <div class="w-12 sm:w-24 h-[2px] bg-gradient-to-r from-transparent to-corporate-blue/60 rounded-full"></div>
              <span class="text-[10px] sm:text-[11px] font-bold font-mono uppercase tracking-widest text-corporate-blue shrink-0">
                Sambutan Pimpinan
              </span>
              <div class="w-12 sm:w-24 h-[2px] bg-gradient-to-l from-transparent to-corporate-blue/60 rounded-full"></div>
            </div>
      
            <!-- 2. Area Identitas & Foto (Proporsional di Tengah) -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 mb-12 text-center sm:text-left">
              
              <!-- Foto Profil Kepsek -->
              <div class="w-20 h-28 sm:w-24 sm:h-32 shrink-0 rounded-2xl overflow-hidden shadow-md">
                <img 
                  src={profilKepsek.foto} 
                  alt={`Foto ${profilKepsek.nama}`} 
                  class="w-full h-full object-cover object-top"
                  loading="lazy"
                />
              </div>

        <!-- Metadata Nama & nuptk -->
        <div class="flex flex-col justify-center py-1 sm:py-2">
          <span class="text-xl sm:text-2xl font-extrabold text-blackcoal font-lato tracking-tight mb-1">
            {profilKepsek.nama}
          </span>
          <span class="text-sm sm:text-base font-bold font-comfortaa text-corporate-blue mb-2">
            {profilKepsek.jabatan}
          </span>
          <span class="text-sm sm:text-[13px] font-mono text-gray-500 uppercase tracking-wider">
            {profilKepsek.nuptk}
          </span>
        </div>
        
      </div>

      <!-- 3. Kutipan Utama (Pull-Quote) -->
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-blackcoal font-lato leading-[1.3] mb-8 relative">
        <Icon name="lucide:quote" class="absolute -top-4 -left-3 sm:-left-6 w-8 h-8 sm:w-12 sm:h-12 text-gray-200 -z-10 rotate-180" />
        "{profilKepsek.kutipan}"
      </h2>

      <!-- 4. Teks Tubuh (Body Copy) -->
      <div class="space-y-4 border-l-2 border-gray-200 pl-4 sm:pl-6 text-sm sm:text-base text-gray-600 font-comfortaa leading-relaxed">
        <p>{profilKepsek.paragraf1}</p>
        <p>{profilKepsek.paragraf2}</p>
      </div>

    </div>
  </div>
</section>
