---
// ============================================================================
// DATA FRONTMATTER (Pusat Kendali Konten)
// ============================================================================
const profilKepsek = {
  nama: "Dede Budiman S.pd., M.Si",
  jabatan: "Kepala SMK Bina Wisata Lembang",
  nuptk: "NUPTK. 4148773674130223",
  foto: "/assets/sambutan.jpg",
  
  kutipan: "Pendidikan vokasi bukan sekadar mencetak pekerja, melainkan mengasah inovator yang siap menantang masa depan.",
  
  paragraf1: "Selamat datang di SMK Bina Wisata Lembang. Di era disrupsi teknologi dan transformasi industri saat ini, kami berkomitmen untuk tidak hanya menjadi tempat belajar, tetapi menjadi ekosistem pembentuk karakter dan kompetensi. Tantangan global menuntut lulusan yang adaptif, tangguh, dan memiliki etos kerja profesional.",
  paragraf2: "Melalui kurikulum yang diselaraskan langsung dengan industri (Link & Match), fasilitas laboratorium modern, serta tenaga pendidik tersertifikasi, kami bertekad mengantarkan putra-putri Anda menjadi talenta unggul yang siap memimpin di dunia usaha dan dunia industri (DUDI)."
};
---

<section class="w-full bg-alabaster py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-12 lg:gap-x-16">

      <!-- KOLOM FOTO — frame ringan tegas (backdrop success-green + border putih pada foto) -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">

          <div class="flex flex-row items-center gap-4 lg:flex-col lg:items-stretch lg:gap-0 lg:w-full max-w-xs mx-auto lg:mx-0">

            <!-- Foto: diperkecil di mobile, full di desktop -->
            <div class="relative w-24 sm:w-28 lg:w-full shrink-0">
              <!-- Backdrop frame solid -->
              <div class="absolute top-2 left-2 lg:top-3 lg:left-3 w-full h-full bg-accent-yellow"></div>

              <!-- Foto dengan border putih tegas -->
              <div class="relative aspect-[4/5] overflow-hidden bg-gray-200 border-2 lg:border-4 border-white">
                <img
                  src={profilKepsek.foto}
                  alt={`Foto ${profilKepsek.nama}`}
                  class="w-full h-full object-cover object-top grayscale-[15%]"
                  loading="lazy"
                />
              </div>
            </div>

            <!-- Identitas: kini center secara vertikal sejajar tinggi foto -->
            <div class="flex-1 min-w-0 pl-3 lg:pl-4 mt-0 lg:mt-6 border-l-2 border-accent-yellow text-left">
              <p class="text-sm sm:text-base font-bold text-blackcoal font-lato leading-snug">
                {profilKepsek.nama}
              </p>
              <p class="text-xs sm:text-sm font-lato font-medium mt-1">
                {profilKepsek.jabatan}
              </p>
              <p class="text-xs sm:text-sm text-gray-400 font-mono uppercase tracking-wider mt-1">
                {profilKepsek.nuptk}
              </p>
            </div>
          </div>

        </div>
      </div>

      <!-- KOLOM KONTEN — tipografi sebagai fokus utama -->
      <div class="lg:col-span-8">

        <!-- Overline label: badge highlight, seperti referensi -->
        <div class="inline-flex items-center pl-3 pr-4 py-1.5 mb-6 bg-success-green/10 border-l-4 border-success-green">
          <span class="text-xs font-bold font-lato uppercase tracking-[0.15em] text-success-green">
            Sambutan Kepala Sekolah
          </span>
        </div>

        <!-- Kutipan sebagai headline utama -->
        <h2 class="text-2xl sm:text-3xl lg:[font-size:2.35rem] font-lato font-semibold text-blackcoal leading-[1.35] tracking-tight mb-4 max-w-3xl">
          {profilKepsek.kutipan}
        </h2>

        <!-- Garis aksen di bawah heading -->
        <div class="w-14 h-1 bg-success-green mb-10"></div>

        <!-- Teks Tubuh (Body Copy) -->
        <div class="space-y-5 text-[15px] sm:text-base text-gray-600 font-lato leading-relaxed max-w-2xl">
          <p>{profilKepsek.paragraf1}</p>
          <p>{profilKepsek.paragraf2}</p>
        </div>

      </div>

    </div>
  </div>
</section>