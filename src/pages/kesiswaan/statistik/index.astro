---
// Import Layout Utama
import Layout from '../../../layouts/Layout.astro';
import { Users, GraduationCap, Trophy, PieChart, Briefcase, TrendingUp } from '@lucide/svelte';
import { getCollection } from 'astro:content';

// ============================================================================
// PERINGATAN !
// JANGAN SEMENA-MENA MEMANIPULASI DATA TANPA FAKTA DATA RIIL
// ============================================================================
// ============================================================================
// 1. DATA FETCHING (Mengambil dari Keystatic CMS YAML)
// ============================================================================
const statistikEntries = await getCollection('statistik');

// JARING PENGAMAN: Hentikan eksekusi dan berikan pesan jelas jika fail belum ada
if (statistikEntries.length === 0) {
  throw new Error("Data CMS Kosong: Fail content/statistik/index.yaml belum dibuat. Silakan buka dashboard Keystatic, navigasi ke 'Statistik Kesiswaan', lalu klik 'Save' untuk memproduksi fail pertama.");
}
// Mengambil indeks 0 karena ini adalah data singleton (entitas tunggal)
const statistikData = statistikEntries[0].data;

// ============================================================================
// 2. KALKULASI MATEMATIKA SERVER-SIDE
// (Kode kalkulasi di bawah ini TIDAK PERLU DIUBAH sama sekali karena 
// struktur JSON dari Keystatic sudah dipaksa identik oleh Zod)
// ============================================================================
// A. Demografi Umum
const persenPutra = Math.round((statistikData.demografi.putra / statistikData.demografi.total) * 100);
const persenPutri = Math.round((statistikData.demografi.putri / statistikData.demografi.total) * 100);
const maxSiswaKelas = Math.max(...statistikData.distribusiKelas.map(k => k.jumlah));

// B. Kalkulasi Pie Chart CSS (Conic Gradient)
const totalGtk = statistikData.staffGtk.reduce((acc, curr) => acc + curr.jumlah, 0);
let akumulasiPersenPie = 0;
const pieGradient = statistikData.staffGtk.map(item => {
  const persentase = (item.jumlah / totalGtk) * 100;
  const start = akumulasiPersenPie;
  akumulasiPersenPie += persentase;
  return `${item.warna} ${start}% ${akumulasiPersenPie}%`;
}).join(', ');

// C. Kalkulasi Koordinat Line Chart (SVG Dinamis)
const dataLength = statistikData.pertumbuhanSiswa.length;
const minSpacing = 110; 
const padX = 50; 
const padY = 30;

const svgWidth = Math.max(500, (dataLength - 1) * minSpacing + (padX * 2)); 
const svgHeight = 240; 

const maxPertumbuhan = Math.max(...statistikData.pertumbuhanSiswa.map(d => d.jumlah));
const minPertumbuhan = Math.min(...statistikData.pertumbuhanSiswa.map(d => d.jumlah));

const chartMax = Math.ceil(maxPertumbuhan / 100) * 100;
const chartMin = Math.floor(minPertumbuhan / 100) * 100;
const rangeY = chartMax - chartMin;
const rangeX = dataLength - 1;

const svgPoints = statistikData.pertumbuhanSiswa.map((d, i) => {
  const x = padX + (i * (svgWidth - 2 * padX) / rangeX);
  const y = svgHeight - padY - ((d.jumlah - chartMin) / rangeY) * (svgHeight - 2 * padY);
  return `${x},${y}`;
}).join(' ');
---

<Layout title="Statistik Kesiswaan | SMK Bina Wisata Lembang">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20">

    <header class="text-center mb-16">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-blackcoal tracking-tight mb-4">
        Statistik Pendidikan
      </h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm sm:text-base">
        Transparansi data demografi, keterserapan alumni, hingga grafik tren pertumbuhan institusi kami.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">

      <!-- 1. Demografi Siswa -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col">
              <div class="flex items-center gap-3 mb-8">
                <div class="p-3 bg-corporate-blue/10 rounded-xl text-corporate-blue shrink-0">
                  <Users size={24} />
                </div>
                <!-- PERBAIKAN: Pembungkus flex untuk H2 dan Lencana Tahun -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
              <h2 class="text-xl font-bold text-blackcoal m-0">Demografi Siswa</h2>
              <span class="px-2.5 py-1 bg-gray-50 text-gray-500 text-[11px] sm:text-xs font-bold rounded-lg border border-gray-200 uppercase tracking-wide mt-1 sm:mt-0">
                T.A {statistikData.demografi.tahun}
            </span>
          </div>
        </div>

        <div class="flex items-end gap-2 mb-6">
          <span class="text-5xl font-extrabold font-lato text-corporate-blue leading-none">{statistikData.demografi.total}</span>
          <span class="text-gray-500 font-bold mb-1">Siswa Aktif</span>
        </div>

        <div class="w-full h-4 rounded-full flex overflow-hidden mb-3 bg-gray-100">
          <div class="h-full bg-corporate-blue" style={`width: ${persenPutra}%`} title="Putra"></div>
          <div class="h-full bg-accent-yellow" style={`width: ${persenPutri}%`} title="Putri"></div>
        </div>

        <div class="flex justify-between text-sm font-bold mt-auto">
          <div class="flex items-center gap-2 text-gray-700">
            <div class="w-3 h-3 rounded-full bg-corporate-blue"></div>
            Putra ({persenPutra}%)
          </div>
          <div class="flex items-center gap-2 text-gray-700">
            <div class="w-3 h-3 rounded-full bg-accent-yellow"></div>
            Putri ({persenPutri}%)
          </div>
        </div>
      </section>

      <!-- 2. Distribusi Per Kelas -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-3 bg-success-green/10 rounded-xl text-success-green">
            <PieChart size={24} />
          </div>
          <h2 class="text-xl font-bold text-blackcoal m-0">Distribusi Rombongan Belajar</h2>
        </div>

        <div class="flex flex-col gap-4 mt-auto">
          {statistikData.distribusiKelas.map((item) => (
            <div>
              <div class="flex justify-between text-sm font-bold text-gray-700 mb-1">
                <span>{item.tingkat}</span>
                <span>{item.jumlah} Siswa</span>
              </div>
              <div class="w-full bg-gray-100 rounded-full h-2.5">
                <div class={`h-2.5 rounded-full ${item.warna}`} style={`width: ${(item.jumlah / maxSiswaKelas) * 100}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Keterserapan Alumni -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-3 bg-corporate-blue/10 rounded-xl text-corporate-blue">
            <GraduationCap size={24} />
          </div>
          <h2 class="text-xl font-bold text-blackcoal m-0">Serapan Lulusan</h2>
        </div>

        <div class="flex flex-col gap-5 mt-auto">
          {statistikData.serapanAlumni.map((item) => (
            <div class="flex items-center gap-4">
              <div class="w-12 text-right">
                <span class="text-lg font-extrabold text-gray-800">{item.persentase}%</span>
              </div>
              <div class="flex-1">
                <div class="text-sm font-bold text-gray-600 mb-1">{item.status}</div>
                <div class="w-full bg-gray-100 rounded-full h-2">
                  <div class={`h-2 rounded-full ${item.warna}`} style={`width: ${item.persentase}%`}></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Pie Chart: Staff GTK -->
      <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col">
        <div class="flex items-center gap-3 mb-6">
          <div class="p-3 bg-accent-yellow/10 rounded-xl text-accent-yellow">
            <Briefcase size={24} />
          </div>
          <h2 class="text-xl font-bold text-blackcoal m-0">Tenaga Pendidik & Staf</h2>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-8 mt-auto">
          <!-- Render CSS Pie Chart (Donut Style) -->
          <div
            class="w-32 h-32 sm:w-40 sm:h-40 rounded-full relative shrink-0 shadow-inner"
            style={`background: conic-gradient(${pieGradient});`}
          >
            <!-- Inner circle to make it a Donut Chart -->
            <div class="absolute inset-3 bg-white rounded-full flex items-center justify-center flex-col shadow-sm">
              <span class="text-2xl font-extrabold font-lato leading-none text-blackcoal">{totalGtk}</span>
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider mt-1">Total</span>
            </div>
          </div>

          <div class="flex flex-col gap-3 w-full">
            {statistikData.staffGtk.map((item) => (
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${item.warna}`}></div>
                  <span class="text-sm font-bold text-gray-700">{item.peran}</span>
                </div>
                <span class="text-sm font-extrabold text-gray-900">{item.jumlah}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 5. Line Chart: Pertumbuhan Siswa -->
            <section class="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:col-span-2">
              <div class="flex items-center gap-3 mb-8">
                <div class="p-3 bg-success-green/10 rounded-xl text-success-green">
                  <TrendingUp size={24} />
                </div>
                <h2 class="text-xl font-bold text-blackcoal m-0">Tren Pertumbuhan Siswa</h2>
              </div>

              <!-- PERBAIKAN: Wadah responsif dengan custom-scrollbar -->
              <div class="w-full overflow-x-auto custom-scrollbar pb-4 -mx-2 px-2 sm:mx-0 sm:px-0">

                <!-- PERBAIKAN: Gaya CSS spesifik agar lebar minimal memicu fungsi scrollbar -->
                <svg
                  viewBox={`0 0 ${svgWidth} ${svgHeight}`}
                  class="h-auto drop-shadow-sm font-lato"
                  style={`width: ${svgWidth}px; min-width: 100%;`}
                >
                  <!-- Grid Garis Horisontal -->
                  <line x1={padX} y1={padY} x2={svgWidth - padX} y2={padY} stroke="#f3f4f6" stroke-width="1" />
                  <line x1={padX} y1={svgHeight / 2} x2={svgWidth - padX} y2={svgHeight / 2} stroke="#f3f4f6" stroke-width="1" />
                  <line x1={padX} y1={svgHeight - padY} x2={svgWidth - padX} y2={svgHeight - padY} stroke="#e5e7eb" stroke-width="2" />

                  <!-- Label Sumbu Y (Dibuat melayang statis atau mengikuti rentang) -->
                  <text x={padX - 10} y={padY + 4} text-anchor="end" class="text-[10px] fill-gray-400 font-bold">{chartMax}</text>
                  <text x={padX - 10} y={svgHeight - padY + 4} text-anchor="end" class="text-[10px] fill-gray-400 font-bold">{chartMin}</text>

                  <!-- Garis Utama (Line Chart) -->
                  <polyline
                    fill="none"
                    stroke="#3ba2d5"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    points={svgPoints}
                  />

                  <!-- Titik Data & Label Sumbu X -->
                  {statistikData.pertumbuhanSiswa.map((d, i) => {
                    const cx = padX + (i * (svgWidth - 2 * padX) / rangeX);
                    const cy = svgHeight - padY - ((d.jumlah - chartMin) / rangeY) * (svgHeight - 2 * padY);
                    return (
                      <g class="transition-transform hover:scale-90 origin-center" style={`transform-origin: ${cx}px ${cy}px;`}>
                        <circle cx={cx} cy={cy} r="4" fill="white" stroke="#3ba2d5" stroke-width="2" />
                        <text x={cx} y={cy - 12} text-anchor="middle" class="text-[11px] fill-gray-700 font-extrabold">{d.jumlah}</text>
                        <text x={cx} y={svgHeight - padY + 20} text-anchor="middle" class="text-xs fill-gray-500 font-bold">{d.tahun}</text>
                      </g>
                    );
                  })}
                </svg>
              </div>
            </section>

      <!-- 6. Rekapitulasi Prestasi -->
      <section class="bg-corporate-blue p-6 sm:p-8 rounded-2xl shadow-sm border border-corporate-blue/50 text-white flex flex-col md:col-span-2">
        <div class="flex items-center gap-3 mb-8">
          <div class="p-3 bg-white/20 rounded-xl text-white backdrop-blur-sm">
            <Trophy size={24} />
          </div>
          <h2 class="text-xl font-bold m-0 text-white">Rekapitulasi Prestasi Lomba</h2>
        </div>

        <div class="grid grid-cols-3 gap-4 mt-auto divide-x divide-white/20 text-center">
          <div class="flex flex-col">
            <span class="text-3xl sm:text-4xl font-extrabold font-lato">{statistikData.prestasi.kabupaten}</span>
            <span class="text-xs sm:text-sm font-bold text-white/80 uppercase tracking-wider mt-1">Kabupaten</span>
          </div>
          <div class="flex flex-col">
            <span class="text-3xl sm:text-4xl font-extrabold font-lato">{statistikData.prestasi.provinsi}</span>
            <span class="text-xs sm:text-sm font-bold text-white/80 uppercase tracking-wider mt-1">Provinsi</span>
          </div>
          <div class="flex flex-col">
            <span class="text-3xl sm:text-4xl font-extrabold font-lato text-accent-yellow">{statistikData.prestasi.nasional}</span>
            <span class="text-xs sm:text-sm font-bold text-white/80 uppercase tracking-wider mt-1">Nasional</span>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
