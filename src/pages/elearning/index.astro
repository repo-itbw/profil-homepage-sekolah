---
import Layout from '../../layouts/Layout.astro'; // Sesuaikan jalur jika menggunakan BaseLayout.astro
import { getCollection } from 'astro:content';
import SmartDock from '../../components/SmartDock.svelte';

const semuaMateri = await getCollection('elearning');
const materiUrut = semuaMateri.sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);

const formatTanggal = (tanggal: Date) => {
  return new Intl.DateTimeFormat('id-ID', {
    day: '2-digit', month: 'short', year: 'numeric'
  }).format(tanggal);
};

// Fungsi pembantu untuk memformat kategori menjadi URL yang valid (misal: "Bahasa Indonesia" -> "bahasa-indonesia")
const buatSlugKategori = (kategori: string) => kategori.toLowerCase().replace(/\s+/g, '-');

// Definisi array kategori untuk disuntikkan ke SmartDock
const kategoriElearning = [
  'Semua', 'Matematika', 'Fisika', 'Kimia', 'Biologi', 
  'Bahasa Indonesia', 'Bahasa Inggris', 'Kejuruan Terapan', 'Umum'
];
---

<Layout title="E-Learning & Materi | SMKs Bina Wisata Lembang">
  
  <!-- INTEGRASI SMARTDOCK (Dengan injeksi kategori dinamis) -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 mb-8 sticky top-[72px] lg:top-[76px] z-30">
    <SmartDock 
      client:load 
      mode="arsip" 
      filterCategories={kategoriElearning} 
    />
  </section>

  <!-- KONTEN UTAMA -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <header class="mb-10 text-center sm:text-left border-b border-gray-200 pb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-blackcoal mb-3">Pustaka Materi Digital</h1>
      <p class="text-gray-600 font-comfortaa max-w-2xl text-sm sm:text-base leading-relaxed">
        Akses modul pembelajaran, ringkasan materi, dan sumber daya akademik resmi SMKs Bina Wisata Lembang yang disusun langsung oleh tenaga pendidik profesional dan kontributor resmi.
      </p>
    </header>

    <!-- KISI KARTU E-LEARNING (Top-Heavy Layout) -->
    <div id="elearning-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {materiUrut.map((materi) => (
        <a 
          href={`/elearning/${buatSlugKategori(materi.data.kategori)}/${materi.id}`} 
          class="elearning-card group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-xl border border-gray-100 transition-all duration-300 hover:-translate-y-1.5 overflow-hidden"
          data-title={materi.data.judul.toLowerCase()}
          data-desc={materi.data.deskripsi.toLowerCase()}
          data-category={materi.data.kategori.toLowerCase()}
          data-date={materi.data.tanggal.valueOf()}
        >
          <!-- Blok Atas: Gambar Sampul Penuh -->
          <div class="w-full aspect-[16/10] overflow-hidden bg-gray-50 relative border-b border-gray-100">
            <img
              src={materi.data.image || '/assets/staticAssets/elearning-placeholder.jpg'}
              alt={materi.data.judul}
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <!-- Badge Kategori Mengambang -->
            <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm px-3 py-1.5 rounded-md shadow-sm border border-gray-100 inline-flex items-center justify-center">
              <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-corporate-blue leading-none">
                {materi.data.kategori}
              </span>
            </div>
          </div>

          <!-- Blok Bawah: Informasi Tekstual -->
          <div class="p-5 flex flex-col flex-grow">
            <h2 class="text-lg font-bold text-blackcoal mb-2 line-clamp-2 group-hover:text-corporate-blue transition-colors leading-tight">
              {materi.data.judul}
            </h2>
            
            <p class="text-xs sm:text-sm text-gray-500 line-clamp-2 font-comfortaa leading-relaxed mb-4 flex-grow">
              {materi.data.deskripsi}
            </p>

            <!-- Metadata Pengajar & Tanggal -->
            <div class="flex items-center justify-between pt-4 border-t border-gray-100 text-[10px] sm:text-xs font-comfortaa text-gray-400">
              <span class="font-semibold text-gray-600 flex items-center gap-1.5 truncate pr-2">
                <!-- SVG Ikon Guru/Buku -->
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                {materi.data.pengajar || 'Guru Mata Pelajaran'}
              </span>
              
              <span class="flex-shrink-0">{formatTanggal(materi.data.tanggal)}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    
    <!-- Pesan Data Kosong -->
    <div id="no-results-elearning" class="hidden text-center py-16 border-2 border-dashed border-gray-200 rounded-xl mt-8 bg-gray-50/50">
      <p class="text-gray-500 font-lato">Tidak ada materi yang cocok dengan kriteria pencarian.</p>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    // Penamaan variabel disesuaikan agar tidak bentrok dengan halaman berita
    const grid = document.getElementById('elearning-grid');
    const noResults = document.getElementById('no-results-elearning');
    
    if (!grid) return;

    const cards = Array.from(document.querySelectorAll('.elearning-card')) as HTMLElement[];

    const handleFilter = (e: CustomEvent) => {
      const { search, category, sort } = e.detail;
      const activeCat = category.toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const desc = card.dataset.desc || '';
        const cat = card.dataset.category || '';

        const matchesSearch = title.includes(search) || desc.includes(search);
        const matchesCategory = activeCat === 'semua' || cat === activeCat;

        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        grid.style.display = visibleCount === 0 ? 'none' : 'grid';
      }

      const sortedCards = cards.sort((a, b) => {
        const dateA = parseInt(a.dataset.date || '0');
        const dateB = parseInt(b.dataset.date || '0');
        return sort === 'terbaru' ? dateB - dateA : dateA - dateB;
      });

      sortedCards.forEach(card => grid.appendChild(card));
    };

    window.removeEventListener('smartdock-filter', handleFilter as EventListener);
    window.addEventListener('smartdock-filter', handleFilter as EventListener);
  });
</script>
