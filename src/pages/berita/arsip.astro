---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 1. IMPOR KOMPONEN SVELTE
import SmartDock from '../../components/SmartDock.svelte';

const semuaBerita = await getCollection('berita');
const beritaUrut = semuaBerita.sort(
  (a, b) => b.data.tanggal.valueOf() - a.data.tanggal.valueOf()
);

const formatTanggal = (tanggal: Date) => {
  return new Intl.DateTimeFormat('id-ID', {
    day: '2-digit', month: 'short', year: 'numeric'
  }).format(tanggal);
};
---

<Layout title="Arsip Berita | SMKs Bina Wisata Lembang">
  
  <!-- INTEGRASI SMARTDOCK -->
  <!-- client:load = Arahan (directive) Astro untuk memastikan Javascript komponen ini langsung dieksekusi oleh peramban klien -->
  <section class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 mb-8 sticky top-[72px] lg:top-[76px] z-30">
    <SmartDock client:load mode="arsip" />
  </section>

  <!-- KONTEN UTAMA -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
    <header class="mb-10 text-center sm:text-left">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-blackcoal mb-3">Arsip Berita & Pengumuman</h1>
      <p class="text-gray-600 font-comfortaa max-w-2xl text-sm sm:text-base leading-relaxed">
        Menyajikan informasi terbaru seputar kegiatan, prestasi, dan pengumuman resmi dari SMKs Bina Wisata Lembang.
      </p>
      <p class="text-gray-600 font-comfortaa max-w-2xl text-sm sm:text-base leading-relaxed">
        Telah dikurasi & diterbitkan oleh ekstrakurikuler BWJURNAL.
      </p>
    </header>

    <!-- KISI KARTU BERITA (Tambahan id="news-grid" untuk target Javascript) -->
    <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {beritaUrut.map((berita) => (
        <a 
          href={`/berita/${berita.id}`} 
          class="news-card group flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-xl active:shadow-xl border border-gray-100 transition-all duration-300 hover:-translate-y-1.5 active:-translate-y-1.5 overflow-hidden min-h-[320px]"
          // Injeksi atribut data-* untuk dibaca oleh filter Javascript
          data-title={berita.data.judul.toLowerCase()}
          data-desc={berita.data.deskripsi.toLowerCase()}
          data-category={berita.data.kategori.toLowerCase()}
          data-date={berita.data.tanggal.valueOf()}
        >
          <!-- Blok Atas: Informasi Tekstual & Metadata -->
          <div class="p-5 pb-4 flex flex-col flex-grow">
            <div class="mb-3">
              <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wider text-corporate-blue bg-corporate-blue/10 px-2.5 py-1 rounded-md">
                {berita.data.kategori}
              </span>
            </div>
            
            <h2 class="text-lg sm:text-xl font-bold text-blackcoal mb-2 line-clamp-2 group-hover:text-corporate-blue group-active:text-corporate-blue transition-colors leading-tight">
              {berita.data.judul}
            </h2>
            
            <!-- Metadata Gabungan -->
            <div class="flex items-center gap-1.5 text-[10px] sm:text-xs font-comfortaa text-gray-400 mb-3">
              <span class="font-semibold text-gray-500 truncate max-w-[120px]">
                Oleh: {berita.data.penerbit || 'Admin'}
              </span>
              <span>&bull;</span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                {formatTanggal(berita.data.tanggal)}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-gray-500 line-clamp-2 font-comfortaa leading-relaxed mt-auto">
              {berita.data.deskripsi}
            </p>
          </div>

          <!-- Blok Bawah: Gambar Persegi Panjang -->
          <div class="px-5 pb-5">
            <div class="w-full aspect-video rounded-xl overflow-hidden bg-gray-100 border border-gray-100 relative">
              <img
                src={berita.data.image || '/assets/staticAssets/placeholder.jpg'}
                alt={berita.data.judul}
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 group-active:scale-105 transition-transform duration-500"
              />
            </div>
          </div>
        </a>
      ))}
    </div>
    
    <!-- Pesan Data Kosong -->
    <div id="no-results" class="hidden text-center py-16 border-2 border-dashed border-gray-200 rounded-xl mt-8">
      <p class="text-gray-500 font-lato">Tidak ada berita yang cocok dengan kriteria pencarian.</p>
    </div>
  </main>
</Layout>

<!-- LOGIKA PENYARINGAN SISI KLIEN (Vanilla JS) -->
<script>
  // Menggunakan 'astro:page-load' sebagai solusi global untuk navigasi View Transitions
  document.addEventListener('astro:page-load', () => {
    
    // 1. Ambil DOM yang paling baru (Fresh DOM)
    const grid = document.getElementById('news-grid');
    const noResults = document.getElementById('no-results');
    
    // Klausul Pelindung: Jika bukan di halaman arsip, hentikan skrip
    if (!grid) return;

    const cards = Array.from(document.querySelectorAll('.news-card')) as HTMLElement[];

    // 2. Daftarkan event listener Svelte SETELAH halaman dipastikan siap oleh Astro
    // Tambahkan opsi { once: true } jika ingin menghindari penumpukan event listener
    const handleFilter = (e: CustomEvent) => {
      const { search, category, sort } = e.detail;
      const activeCat = category.toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const desc = card.dataset.desc || '';
        const cat = card.dataset.category || '';

        const matchesSearch = title.includes(search) || desc.includes(search);
        const matchesCategory = activeCat === 'semua' || cat === activeCat;

        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        grid.style.display = visibleCount === 0 ? 'none' : 'grid';
      }

      const sortedCards = cards.sort((a, b) => {
        const dateA = parseInt(a.dataset.date || '0');
        const dateB = parseInt(b.dataset.date || '0');
        return sort === 'terbaru' ? dateB - dateA : dateA - dateB;
      });

      sortedCards.forEach(card => grid.appendChild(card));
    };

    // Bersihkan listener lama (jika ada) sebelum memasang yang baru untuk mencegah memory leak
    window.removeEventListener('smartdock-filter', handleFilter as EventListener);
    window.addEventListener('smartdock-filter', handleFilter as EventListener);
    
  });
</script>
