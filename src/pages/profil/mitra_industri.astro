---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

// 1. Ekstraksi Data dari CMS
const mitraEntries = await getCollection('mitra');

// Jaring pengaman jika fail belum di-generate
if (mitraEntries.length === 0) {
  throw new Error("Data Mitra Industri belum ada. Silakan buat entitas pertamanya di dasbor Keystatic lalu Save.");
}

const data = mitraEntries[0].data;

// Catatan: Variabel filter 'mitraPrioritas' dan 'marqueeItems' telah dihapus 
// karena seluruh data kini dirender secara serempak di dalam satu grid Masonry.
---

<Layout title="Mitra Industri | SMK Bina Wisata Lembang">
  
  <!-- KANVAS LATAR BELAKANG: Ambient Mesh Gradient -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10 bg-alabaster">
    <div class="absolute top-[-10%] left-[-10%] w-[40vw] h-[40vw] min-w-[500px] bg-corporate-blue/15 rounded-full blur-[100px] mix-blend-multiply"></div>
    <div class="absolute top-[40%] right-[-5%] w-[35vw] h-[35vw] min-w-[400px] bg-accent-yellow/15 rounded-full blur-[120px] mix-blend-multiply"></div>
  </div>

  <main class="relative z-10 pt-16 sm:pt-24 pb-32 overflow-hidden">
    
    <!-- ========================================================== -->
    <!-- BAGIAN 1: HERO SECTION                                     -->
    <!-- ========================================================== -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-20">
      
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-blackcoal font-lato tracking-tight mb-6 leading-tight drop-shadow-sm">
        {data.hero.judul}
      </h1>
      <p class="text-base sm:text-lg text-gray-600 font-comfortaa leading-relaxed max-w-2xl mx-auto mb-10">
        {data.hero.deskripsi}
      </p>

      <div class="flex flex-wrap justify-center gap-4 sm:gap-6">
        {data.statistikBanner.map(stat => (
          <div class="flex flex-col items-center justify-center bg-white/60 backdrop-blur-md border border-white/80 shadow-[0_8px_30px_rgb(0,0,0,0.04)] rounded-2xl px-6 py-4 min-w-[140px] sm:min-w-[160px] transition-transform duration-300 hover:-translate-y-1 active:-translate-y-1">
            <span class="text-2xl sm:text-3xl font-extrabold font-lato text-corporate-blue leading-none mb-1">
              {stat.angka}
            </span>
            <span class="text-[10px] sm:text-xs font-bold font-comfortaa text-gray-500 uppercase tracking-wider text-center">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </section>

    <!-- ========================================================== -->
    <!-- BAGIAN 2: DIREKTORI MITRA (Grid Masonry Terpadu)           -->
    <!-- ========================================================== -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-24 mb-24">
      
      <div class="flex flex-col items-center text-center mb-12">
        <div class="inline-flex items-center justify-center gap-2 mb-4">
          <div class="w-8 h-[2px] bg-corporate-blue"></div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-blackcoal font-lato tracking-tight">Kemitraan Strategis</h2>
          <div class="w-8 h-[2px] bg-corporate-blue"></div>
        </div>
        <p class="text-gray-500 font-comfortaa text-sm sm:text-base max-w-2xl">
          Daftar seluruh entitas industri yang secara aktif berkolaborasi dalam sinkronisasi kurikulum dan penyaluran lulusan kami.
        </p>
      </div>

      <!-- TATA LETAK MASONRY CSS MURNI -->
      <!-- Menggunakan kolom CSS alih-alih Grid tradisional -->
      <div class="columns-2 md:columns-3 lg:columns-4 gap-4 sm:gap-6">
        {data.daftarMitra.map((mitra) => (
          
          /* Atribut 'break-inside-avoid' sangat krusial agar kartu tidak terpotong di tengah antar-kolom */
          <div class="break-inside-avoid mb-4 sm:mb-6 flex flex-col items-center justify-between bg-white/60 backdrop-blur-md border border-white/80 shadow-sm hover:shadow-md active:shadow-md rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 active:-translate-y-1">
            
            <div class="min-h-[4rem] w-full flex items-center justify-center mb-6">
              {mitra.logo ? (
                <img 
                  src={mitra.logo} 
                  alt={mitra.namaPerusahaan} 
                  class="max-h-16 sm:max-h-20 object-contain grayscale opacity-70 hover:grayscale-0 active:grayscale-0 hover:opacity-100 active:opacity-100 transition-all duration-500"
                  loading="lazy"
                />
              ) : (
                <span class="font-lato font-bold text-gray-400 text-sm text-center">
                  {mitra.namaPerusahaan}
                </span>
              )}
            </div>
            
            <!-- Pil Kategori (Badge) -->
            <span class="text-[9px] sm:text-[10px] font-bold font-comfortaa text-corporate-blue bg-corporate-blue/10 px-3 py-1 rounded-full uppercase tracking-wider text-center">
              {mitra.kategori}
            </span>
            
          </div>
        ))}
      </div>
    </section>

    <!-- ========================================================== -->
    <!-- BAGIAN 3: TESTIMONI INDUSTRI (Bento Box Grid)              -->
    <!-- ========================================================== -->
    {data.testimoni.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20 relative">
        
        <h2 class="text-2xl sm:text-3xl font-extrabold text-blackcoal font-lato tracking-tight mb-10 text-center sm:text-left">
          Apa Kata Industri
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {data.testimoni.map((testi) => (
            <div class="bg-white/70 backdrop-blur-lg border border-white/80 shadow-sm rounded-[2rem] p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden group hover:shadow-md active:shadow-md transition-shadow duration-300">
              
              <Icon name="lucide:quote" class="absolute -top-4 -left-4 w-32 h-32 text-corporate-blue/5 -z-10 rotate-180" />

              <p class="font-comfortaa text-gray-700 italic mb-10 leading-relaxed text-sm sm:text-base relative z-10">
                "{testi.kutipan}"
              </p>
              
              <div class="flex items-center gap-4 relative z-10 pt-6 border-t border-gray-200/50">
                {testi.fotoTokoh ? (
                  <img src={testi.fotoTokoh} alt={testi.namaTokoh} class="w-12 h-12 sm:w-14 sm:h-14 rounded-full object-cover shadow-sm"/>
                ) : (
                  <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-corporate-blue/10 flex items-center justify-center shrink-0">
                    <Icon name="lucide:user" class="w-6 h-6 text-corporate-blue"/>
                  </div>
                )}
                
                <div class="flex flex-col">
                  <span class="font-lato font-extrabold text-blackcoal text-sm sm:text-base">
                    {testi.namaTokoh}
                  </span>
                  <span class="font-comfortaa text-[10px] sm:text-xs font-bold text-corporate-blue uppercase tracking-wide mt-0.5">
                    {testi.jabatan}
                  </span>
                </div>
              </div>

            </div>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
